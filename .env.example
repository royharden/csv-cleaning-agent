# Public (browser) configuration. Copy to .env.local and fill in. Every VITE_ value ships to the browser:
# never put a secret behind a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=1
# Previous duplicate: VITE_LIVE_ENABLED=0; use the documented assignment below.
# Owner attestation that a HARD provider/project spend cap is configured (an alert-only budget does not count).
# Leave at 0 until then; live mode stays disabled with the reason shown in the UI.
VITE_LIVE_ENABLED=0

# Server secrets (Bolt Cloud / Supabase edge-function secrets; the local Node eval reads the same names
# from the gitignored .env.local). NAMES ONLY here, never values:
#   ANTHROPIC_API_KEY
#   OPENAI_COMPAT_API_KEY
#   OPENAI_COMPAT_BASE_URL
#   PLANNER_MODEL
#   TYPESAFE_API_KEY
