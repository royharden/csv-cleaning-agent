{
  "name": "csv-cleaning-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first CSV cleaning with a reviewable transform plan, exact undo journal and measured damage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "tsx scripts/verify.ts",
    "eval": "tsx scripts/eval/run.ts",
    "seed": "tsx scripts/seededdirty/generator.ts",
    "check:static": "tsx scripts/check-no-dynamic-code.ts",
    "check:syntax": "node --no-warnings scripts/check-syntax.mjs",
    "fixtures:rekey": "tsx scripts/fixtures-rekey.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "idb": "^8.0.3",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.3.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
